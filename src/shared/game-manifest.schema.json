{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/fun-games/game-manifest.schema.json",
  "title": "Game Manifest",
  "type": "object",
  "required": ["slug", "title", "modes", "supportsAnonymousPlay", "supportsLeaderboards"],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["single-player", "private-invite"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "supportsAnonymousPlay": {
      "type": "boolean"
    },
    "supportsLeaderboards": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
